// Generated by tools/gen_dialog_pages.py. Edit the script, not this file.
// Dialog boards: every dialog is live. Click the buttons, type in the forms, tick the apps.

import { Theme, Brand } from "../theme.slint";
import { StockDialog, DialogKind } from "../dialogs.slint";
import { RootAuthDialog } from "../dialogs_auth.slint";
import { ProgressDialog, ProgKind, FormDialog, FormKind, ListDialog, ListKind, AboutDialog, CrashDialog } from "../dialogs_more.slint";

// The dimmed desktop the dialogs sit on.
component Backdrop inherits Rectangle {
    background: Theme.dark
        ? @linear-gradient(160deg, #2B2B2E 0%, #161617 48%, #3B2A38 100%)
        : @linear-gradient(160deg, #6E6E73 0%, #58585C 48%, #6C5868 100%);
}

component Fam inherits Rectangle {
    in property <string> title;
    in property <string> note;
    height: 66px;
    Text { x: 0px; y: 0px; width: root.width; height: 28px; text: root.title; color: #FFFFFF; font-size: 20px; font-weight: 600; vertical-alignment: center; }
    Text { x: 0px; y: 30px; width: root.width; height: 20px; text: root.note; color: Theme.dark ? #C8C8CE : #E8E9EE; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Rectangle { x: 0px; y: 56px; width: root.width; height: 1px; background: Theme.dark ? rgba(255, 255, 255, 0.16) : rgba(255, 255, 255, 0.28); }
}

component Lab inherits Text {
    height: 18px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
}

component Title inherits Rectangle {
    in property <string> title;
    in property <string> note;
    height: 72px;
    Text { x: 0px; y: 0px; width: root.width; height: 44px; text: root.title; color: #FFFFFF; font-size: 34px; font-weight: 600; vertical-alignment: center; }
    Text { x: 0px; y: 46px; width: root.width; height: 24px; text: root.note; color: Theme.dark ? #C8C8CE : #E8E9EE; font-size: 14.5px; vertical-alignment: center; overflow: elide; }
}

