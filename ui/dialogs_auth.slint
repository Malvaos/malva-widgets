// Administrator permission dialog: confirm, password, wrong password, fingerprint,
// checking, locked and success. Try it: type anything, press Authenticate.
// The first attempt is rejected on purpose; the second is accepted.

import { Theme, Brand } from "theme.slint";
import { Icon, IconDef, Icons, Spinner, DashedBorder } from "base.slint";
import { Btn, BtnKind } from "controls.slint";
import { Field } from "fields.slint";
import { DialogCard, DlgButton, DlgBox, DlgPara } from "dialogs.slint";

export struct DlgFact {
    key: string,
    value: string,
}

// Gray box of "key ... value" lines.
export component DlgFacts inherits Rectangle {
    in property <[DlgFact]> items;
    in property <length> indent: 24px;
    in property <length> gap: 14px;
    height: root.gap + 8px + root.items.length * 36px;
    Rectangle {
        x: root.indent;
        y: root.gap;
        width: root.width - root.indent - 24px;
        height: parent.height - root.gap;
        border-radius: 10px;
        background: Theme.chip;
        for f[i] in root.items: Rectangle {
            x: 12px;
            y: 4px + i * 36px;
            width: parent.width - 24px;
            height: 36px;
            if i > 0: Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
            Text { x: 0px; y: 0px; width: 110px; height: parent.height; text: f.key; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
            Text { x: 110px; y: 0px; width: parent.width - 110px; height: parent.height; text: f.value; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        }
    }
}

// Text-only action under the content ("Use fingerprint instead").
component LinkRow inherits Rectangle {
    in property <string> text;
    in property <IconDef> icon;
    callback clicked();
    height: 4px + 44px;
    Rectangle {
        x: 12px;
        y: 4px;
        width: lt.preferred-width + 24px + 22px;
        height: 44px;
        border-radius: 10px;
        background: la.has-hover ? Theme.accent-soft : transparent;
        accessible-role: AccessibleRole.button;
        accessible-label: root.text;
        Icon { x: 12px; y: (parent.height - self.height) / 2; icon: root.icon; size: 14px; tint: Theme.accent-text; }
        lt := Text { x: 34px; y: 0px; height: parent.height; text: root.text; color: Theme.accent-text; font-size: 13.5px; font-weight: 500; vertical-alignment: center; }
        la := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component RootAuthDialog inherits Rectangle {
    // 0 confirm, 1 password, 2 wrong, 3 fingerprint, 4 checking, 5 locked, 6 success
    in-out property <int> phase: 1;
    in-out property <string> pw;
    in-out property <bool> eye: false;
    in-out property <bool> stay: false;
    in-out property <int> tries: 0;
    in-out property <bool> closed: false;
    callback authorized();

    property <bool> wrong: root.phase == 2;
    property <[DlgButton]> b-confirm: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Continue", kind: BtnKind.primary, enabled: true }];
    property <[DlgButton]> b-pw: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Authenticate", kind: BtnKind.primary, enabled: root.pw != "" }];
    property <[DlgButton]> b-wait: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Authenticate", kind: BtnKind.primary, enabled: false }];
    property <[DlgButton]> b-finger: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }];
    property <[DlgButton]> b-done: [{ text: "Done", kind: BtnKind.primary, enabled: true }];
    property <[DlgFact]> f-confirm: [{ key: "App", value: "Terminal" }, { key: "Runs as", value: "root" }];
    property <[DlgFact]> f-action: [{ key: "Action", value: "End process \{Brand.compositor}" }, { key: "Requested by", value: "Task Manager" }];

    width: 440px;
    height: root.closed ? 132px : card.height;

    Timer {
        interval: 1200ms;
        running: root.phase == 4;
        triggered => {
            if (root.tries >= 1) {
                root.phase = 6;
                root.authorized();
            } else {
                root.tries = 1;
                root.phase = 2;
            }
        }
    }

    if root.closed: Rectangle {
        x: 0px;
        y: 0px;
        width: 440px;
        height: 132px;
        border-radius: 16px;
        background: Theme.panel;
        DashedBorder { x: 0px; y: 0px; width: parent.width; height: parent.height; radius: 16px; ink: Theme.rule; thickness: 2px; dash: 7px; gap: 5px; }
        Text { x: 0px; y: 28px; width: parent.width; height: 20px; text: "Dialog closed"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        Btn { x: (parent.width - self.width) / 2; y: 58px; text: "Show it again"; clicked => { root.closed = false; root.phase = 1; root.pw = ""; root.tries = 0; } }
    }
    card := DialogCard {
        x: 0px;
        y: 0px;
        visible: !root.closed;
        w: 440px;
        tile: 44px;
        icon: root.phase == 0 ? Icons.shield-halved : root.phase == 5 ? Icons.lock : root.phase == 6 ? Icons.shield-halved : root.phase == 3 ? Icons.fingerprint : Icons.lock;
        tone: root.phase == 0 ? 1 : root.phase == 5 ? 2 : root.phase == 6 ? 3 : 0;
        title: root.phase == 0 ? "Run Terminal as administrator?" : root.phase == 5 ? "Too many wrong tries" : "Authentication required";
        sub: root.phase == 0 ? "This needs your permission" : root.phase == 5 ? "Authentication is paused" : "Task Manager wants to change the system";
        buttons: root.phase == 0 ? root.b-confirm : root.phase == 1 || root.phase == 2 ? root.b-pw : root.phase == 3 ? root.b-finger : root.phase == 6 ? root.b-done : root.b-wait;
        pick(n) => {
            if (root.phase == 6) {
                root.closed = true;
            } else if (n == 0) {
                root.closed = true;
            } else if (root.phase == 0) {
                root.phase = 1;
            } else if (root.phase == 1 || root.phase == 2) {
                root.phase = 4;
            }
        }
        close => { root.closed = true; }

        // confirm
        if root.phase == 0: DlgPara { text: "It will be able to change system files and settings. Only continue if you trust this app."; indent: 82px; }
        if root.phase == 0: DlgFacts { items: root.f-confirm; indent: 82px; }
        if root.phase == 0: Rectangle {
            height: 8px + 44px;
            Rectangle {
                x: 70px;
                y: 8px;
                width: parent.width - 70px - 24px;
                height: 44px;
                border-radius: 10px;
                background: sa.has-hover ? Theme.hover : transparent;
                DlgBox { x: 12px; y: 12px; checked: root.stay; }
                Text { x: 42px; y: 0px; width: parent.width - 54px; height: parent.height; text: "Stay authorized for 5 minutes"; color: Theme.text; font-size: 13.5px; vertical-alignment: center; }
                sa := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.stay = !root.stay; }
                }
            }
        }
        // password and wrong password
        if root.phase == 1 || root.phase == 2: DlgFacts { items: root.f-action; }
        if root.phase == 1 || root.phase == 2: Rectangle {
            height: 14px + 48px;
            Rectangle {
                x: 24px;
                y: 14px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Theme.hover2;
                Icon { icon: Icons.user; size: 15px; tint: Theme.sub; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            Text { x: 72px; y: 14px; width: 200px; height: 20px; text: "Administrator"; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            Text { x: 72px; y: 33px; width: 200px; height: 17px; text: "admin"; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
        }
        if root.phase == 1 || root.phase == 2: Rectangle {
            height: 8px + pwf.height;
            pwf := Field {
                x: 24px;
                y: 8px;
                width: parent.width - 48px;
                label: "Password";
                text <=> root.pw;
                password: !root.eye;
                error: root.wrong ? "Wrong password. 2 tries left." : "";
                trail: root.eye ? Icons.eye-slash : Icons.eye;
                trail-name: root.eye ? "Hide password" : "Show password";
                trail-clicked => { root.eye = !root.eye; }
                edited(t) => { if (root.phase == 2) { root.phase = 1; } }
            }
        }
        if root.phase == 1 || root.phase == 2: LinkRow { text: "Use fingerprint instead"; icon: Icons.fingerprint; clicked => { root.phase = 3; } }
        // fingerprint
        if root.phase == 3: Rectangle {
            height: 18px + 176px;
            Rectangle {
                x: 24px;
                y: 18px;
                width: parent.width - 48px;
                height: 176px;
                border-radius: 12px;
                background: Theme.chip;
                Rectangle {
                    x: (parent.width - 96px) / 2;
                    y: 22px;
                    width: 96px;
                    height: 96px;
                    border-radius: 48px;
                    background: Theme.fade(Theme.accent, 0.16);
                    Icon { icon: Icons.fingerprint; size: 44px; tint: Theme.accent; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                Text { x: 0px; y: 126px; width: parent.width; height: 22px; text: "Touch the fingerprint reader"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                Text { x: 0px; y: 148px; width: parent.width; height: 18px; text: "to let Task Manager end this process"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if root.phase == 3: LinkRow { text: "Use password instead"; icon: Icons.lock; clicked => { root.phase = 1; } }
        // checking
        if root.phase == 4: Rectangle {
            height: 18px + 118px;
            Rectangle {
                x: 24px;
                y: 18px;
                width: parent.width - 48px;
                height: 118px;
                border-radius: 12px;
                background: Theme.chip;
                accessible-role: AccessibleRole.text;
                accessible-label: "Checking your password";
                Spinner { x: (parent.width - 32px) / 2; y: 30px; size: 32px; ink: Theme.accent; stroke: 3px; }
                Text { x: 0px; y: 76px; width: parent.width; height: 22px; text: "Checking your password"; color: Theme.text; font-size: 14.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // locked
        if root.phase == 5: Rectangle {
            height: 18px + 80px;
            Rectangle {
                x: 24px;
                y: 18px;
                width: parent.width - 48px;
                height: 80px;
                border-radius: 12px;
                background: Theme.chip;
                Text { x: 16px; y: 14px; width: 200px; height: 30px; text: "Try again in"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                Text { x: parent.width - 116px; y: 12px; width: 100px; height: 32px; text: "1:58"; color: Theme.text; font-size: 22px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle {
                    x: 16px;
                    y: 56px;
                    width: parent.width - 32px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.track;
                    clip: true;
                    Rectangle { x: 0px; y: 0px; width: parent.width * 0.98; height: parent.height; border-radius: 3px; background: Theme.danger-line; }
                }
            }
        }
        if root.phase == 5: DlgPara { text: "The wrong password was entered 3 times. Waiting protects your system from guessing."; indent: 24px; top: 12px; px: 13.5px; }
        // success
        if root.phase == 6: Rectangle {
            height: 18px + 130px;
            Rectangle {
                x: 24px;
                y: 18px;
                width: parent.width - 48px;
                height: 130px;
                border-radius: 12px;
                background: Theme.chip;
                Icon { icon: Icons.circle-check; size: 40px; tint: Theme.ok; x: (parent.width - self.width) / 2; y: 24px; }
                Text { x: 0px; y: 74px; width: parent.width; height: 22px; text: "Authorized"; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                Text { x: 0px; y: 96px; width: parent.width; height: 18px; text: "Task Manager can end the process now."; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}
