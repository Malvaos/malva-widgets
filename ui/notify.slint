// Toasts, banners, the notification center and the quick settings panel.
// Close a card, press Undo, switch Do not disturb: everything answers.
// Sizes follow the design boards: 44 px targets, 14 px toast corners, 20 px panels.

import { Theme, Brand } from "theme.slint";
import { Icon, IconDef, Icons, Surface, Elevation, DashedBorder, FocusRing } from "base.slint";
import { Btn, BtnKind, Slide } from "controls.slint";
import { Tone } from "tone.slint";

// Dashed placeholder that stands where a closed toast or panel was, with a way back.
export component ClosedStub inherits Rectangle {
    in property <string> line1;
    in property <string> line2;
    in property <length> radius: 14px;
    callback reopen();
    property <length> ch: 19px + (root.line2 != "" ? 24px : 0px) + 6px + 44px;
    property <length> top: (root.height - root.ch) / 2;
    background: Theme.panel;
    border-radius: root.radius;
    DashedBorder { x: 0px; y: 0px; width: parent.width; height: parent.height; radius: root.radius; ink: Theme.rule; thickness: 2px; dash: 7px; gap: 5px; }
    Text { x: 0px; y: root.top; width: parent.width; height: 19px; text: root.line1; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    if root.line2 != "": Text { x: 0px; y: root.top + 25px; width: parent.width; height: 18px; text: root.line2; color: Theme.muted; font-size: 12.5px; horizontal-alignment: center; vertical-alignment: center; }
    Btn { x: (parent.width - self.width) / 2; y: root.top + root.ch - 44px; text: "Show it again"; pad: 16px; clicked => { root.reopen(); } }
}

// ---------------------------------------------------------------------------
// Toast: 380 px wide, six kinds. Undo counts down, progress fills, Esc closes.
// ---------------------------------------------------------------------------
export enum ToastKind { info, success, warning, error, undo, progress }

export component Toast inherits Rectangle {
    in property <ToastKind> kind: ToastKind.info;
    // false freezes the countdown and the download so a still picture is stable
    in property <bool> live: false;
    in property <string> title: root.kind == ToastKind.success ? "Preset saved"
        : root.kind == ToastKind.warning ? "Memory is high"
        : root.kind == ToastKind.error ? "Can’t read the CPU sensor"
        : root.kind == ToastKind.undo ? (root.undone ? "CPU widget restored" : "CPU widget removed")
        : root.kind == ToastKind.progress ? (root.done ? "Widgets updated" : "Updating widgets")
        : "Layout saved";
    in property <string> body: root.kind == ToastKind.success ? "“Evening” is ready in Add widgets, under Presets."
        : root.kind == ToastKind.warning ? "91% in use. Web Browser uses 987 MB."
        : root.kind == ToastKind.error ? "The widget shows the last known value. Trying again in 5 s."
        : root.kind == ToastKind.undo ? (root.undone ? "It is back where it was on your desktop." : "It is gone from your desktop.")
        : root.kind == ToastKind.progress ? (root.done ? "You are now on version 0.9.3." : "Downloading 0.9.3, 24 MB")
        : "Your widgets will stay put next time.";
    in property <string> action-a: root.kind == ToastKind.success ? "View presets"
        : root.kind == ToastKind.warning ? "Open Task Manager"
        : root.kind == ToastKind.error ? "Try now"
        : root.kind == ToastKind.undo ? (root.undone ? "" : "Undo (\{Math.max(1, Math.ceil(root.left-ms / 1000))} s)")
        : root.kind == ToastKind.progress ? (root.done ? "Restart widgets" : "Cancel")
        : "";
    in property <string> action-b: root.kind == ToastKind.warning ? "Snooze 1 h" : "";
    in-out property <bool> closed: false;
    in-out property <bool> undone: false;
    in-out property <int> left-ms: root.live ? 8000 : 5200;
    in-out property <float> pct: root.live ? 8 : 62;
    in-out property <string> last;
    callback acted(int);

    property <bool> done: root.kind == ToastKind.progress && root.pct >= 100;
    property <bool> busy: root.kind == ToastKind.progress && !root.done;
    property <bool> counting: root.kind == ToastKind.undo && !root.undone;
    property <bool> has-acts: root.action-a != "";
    property <int> tone: root.undone || root.done || root.kind == ToastKind.success ? 3
        : root.kind == ToastKind.warning ? 1
        : root.kind == ToastKind.error ? 2
        : root.kind == ToastKind.undo ? 4
        : 0;
    property <IconDef> glyph: root.undone || root.done || root.kind == ToastKind.success ? Icons.circle-check
        : root.kind == ToastKind.warning ? Icons.triangle-exclamation
        : root.kind == ToastKind.error ? Icons.circle-exclamation
        : root.kind == ToastKind.undo ? Icons.trash-can
        : root.kind == ToastKind.progress ? Icons.download
        : Icons.circle-info;
    // the design sets paragraphs at 19 px per line; Slint has no line-height, so count lines and use that
    property <length> bd-h: Math.max(1, Math.round(bd-m.preferred-height / 17.7px)) * 19px;
    property <length> col0: 21px + root.bd-h + (root.busy ? 27px : 0px);

    width: 380px;
    height: root.closed ? 132px : 14px + Math.max(36px, root.col0 + (root.has-acts ? 44px : 0px)) + 14px;

    function act(i: int) {
        root.acted(i);
        if (root.counting && i == 0) {
            root.undone = true;
        } else {
            root.last = "You chose “" + (i == 0 ? root.action-a : root.action-b) + "”";
            root.closed = true;
        }
    }
    function reopen() {
        root.closed = false;
        root.undone = false;
        root.left-ms = root.live ? 8000 : 5200;
        root.pct = root.live ? 8 : 62;
    }

    bd-m := Text { visible: false; x: 0px; y: 0px; width: 260px; text: root.body; wrap: TextWrap.word-wrap; font-size: 13px; }

    if root.closed: ClosedStub {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        line1: "Toast closed";
        line2: root.last;
        reopen => { root.reopen(); }
    }
    if !root.closed: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: root.title;

        Timer {
            interval: 100ms;
            running: root.live && ((root.counting && !hv.has-hover) || root.busy);
            triggered => {
                if (root.counting) {
                    if (root.left-ms <= 100) {
                        root.last = "It went away after 8 seconds";
                        root.closed = true;
                        root.left-ms = 8000;
                    } else {
                        root.left-ms -= 100;
                    }
                } else {
                    root.pct = Math.min(100, root.pct + 1.1);
                }
            }
        }

        Surface { x: 0px; y: 0px; width: parent.width; height: parent.height; elevation: Elevation.menu; radius: 14px; }
        hv := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { fs.focus(); }
            Rectangle {
                x: 14px;
                y: 14px;
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: Tone.tile(root.tone);
                Icon { icon: root.glyph; size: 16px; tint: Tone.ink(root.tone); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            Text { x: 62px; y: 15px; width: 260px; height: 20px; text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            Text { x: 62px; y: 35px; width: 260px; height: root.bd-h; text: root.body; wrap: TextWrap.word-wrap; color: Theme.sub; font-size: 13px; }
            if root.busy: Rectangle {
                x: 62px;
                y: 35px + root.bd-h + 10px;
                width: 260px;
                height: 17px;
                Rectangle {
                    x: 0px;
                    y: 5.5px;
                    width: parent.width - 46px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.hover2;
                    clip: true;
                    Rectangle { x: 0px; y: 0px; width: parent.width * Math.min(1, root.pct / 100); height: parent.height; border-radius: 3px; background: Tone.ink(root.tone); }
                }
                Text { x: parent.width - 36px; y: 0px; width: 36px; height: 17px; text: "\{Math.round(root.pct)}%"; color: Theme.sub; font-size: 12.5px; horizontal-alignment: right; vertical-alignment: center; }
            }
            HorizontalLayout {
                x: 50px;
                y: 14px + root.col0 + 4px;
                width: parent.width - 50px - 14px;
                height: 44px;
                spacing: 2px;
                alignment: start;
                if root.action-a != "": Btn { kind: BtnKind.text; text: root.action-a; pad: 12px; min-w: 0px; clicked => { root.act(0); } }
                if root.action-b != "": Btn { kind: BtnKind.text; text: root.action-b; pad: 12px; min-w: 0px; clicked => { root.act(1); } }
            }
            Btn {
                x: parent.width - 2px - 44px;
                y: 2px;
                kind: BtnKind.icon;
                icon: Icons.xmark;
                glyph: 13px;
                pad: 0px;
                clicked => { root.last = "Closed with the close button"; root.closed = true; }
            }
            if root.counting: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                border-radius: 14px;
                clip: true;
                Rectangle { x: 0px; y: parent.height - 3px; width: parent.width * root.left-ms / 8000; height: 3px; background: Theme.muted; animate width { duration: 100ms; easing: linear; } }
            }
        }
        fs := FocusScope {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.last = "Closed with Esc";
                    root.closed = true;
                    return accept;
                }
                return reject;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Banner: lives inside a window. Under 680 px the actions drop below the text.
// ---------------------------------------------------------------------------
export enum BannerKind { info, success, warning, error }

export component Banner inherits Rectangle {
    in property <BannerKind> kind: BannerKind.info;
    in property <string> title: root.kind == BannerKind.success ? "Layout restored"
        : root.kind == BannerKind.warning ? "The CPU sensor is slow"
        : root.kind == BannerKind.error ? "Can’t reach the GPU driver"
        : "New widgets are available";
    in property <string> body: root.kind == BannerKind.success ? "Your Evening layout is back on the desktop."
        : root.kind == BannerKind.warning ? "Updates may lag by a few seconds until it recovers."
        : root.kind == BannerKind.error ? "GPU widgets are paused. Check that the driver is installed and running."
        : "Disk and GPU widgets were added in 0.9.2. Open Add widgets to try them.";
    in property <string> action-a: root.kind == BannerKind.success ? "Undo"
        : root.kind == BannerKind.warning ? "Details"
        : root.kind == BannerKind.error ? "Retry"
        : "Add widgets";
    in property <string> action-b: root.kind == BannerKind.error ? "Open settings" : "";
    in-out property <bool> closed: false;
    in-out property <string> last: "Banner closed";
    callback acted(int);

    property <int> tone: root.kind == BannerKind.success ? 3 : root.kind == BannerKind.warning ? 1 : root.kind == BannerKind.error ? 2 : 0;
    property <bool> stack: root.width < 680px;
    property <length> wa: root.action-a != "" ? ma.preferred-width + 32px : 0px;
    property <length> wb: root.action-b != "" ? mb.preferred-width + 32px : 0px;
    property <length> act-w: root.wa + root.wb + (root.wa > 0px && root.wb > 0px ? 8px : 0px);
    property <bool> has-acts: root.act-w > 0px;
    property <length> text-w: root.stack ? root.width - 108px : root.width - 108px - (root.has-acts ? root.act-w + 12px : 0px);
    property <length> bd-h: Math.max(1, Math.round(bd-m.preferred-height / 17.7px)) * 19px;
    property <length> txt-h: 28px + root.bd-h;
    property <length> row-h: Math.max(root.txt-h, root.has-acts ? 44px : 0px);

    height: root.closed ? 88px
        : root.stack ? 10px + root.txt-h + (root.has-acts ? 4px + 44px : 0px) + 10px
        : Math.max(64px, 10px + root.row-h + 10px);

    function act(i: int) {
        root.acted(i);
        root.last = "You chose “" + (i == 0 ? root.action-a : root.action-b) + "”";
        root.closed = true;
    }

    ma := Text { visible: false; x: 0px; y: 0px; text: root.action-a; font-size: 14px; font-weight: 500; }
    mb := Text { visible: false; x: 0px; y: 0px; text: root.action-b; font-size: 14px; font-weight: 500; }
    bd-m := Text { visible: false; x: 0px; y: 0px; width: root.text-w; text: root.body; wrap: TextWrap.word-wrap; font-size: 13px; }

    if root.closed: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        background: Theme.panel;
        DashedBorder { x: 0px; y: 0px; width: parent.width; height: parent.height; radius: 12px; ink: Theme.rule; thickness: 2px; dash: 7px; gap: 5px; }
        Text { x: 0px; y: 0px; width: (parent.width - 12px) / 2 + 40px; height: parent.height; text: root.last; color: Theme.muted; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Btn { x: (parent.width - 12px) / 2 + 52px; y: 22px; text: "Show it again"; pad: 16px; clicked => { root.closed = false; } }
    }
    if !root.closed: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: root.title;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-radius: 12px;
            background: Tone.banner-bg(root.tone);
            border-width: 1px;
            border-color: Tone.banner-line(root.tone);
        }
        Icon {
            x: 17px;
            y: root.stack ? 15px : 10px + (root.row-h - 18px) / 2;
            icon: root.kind == BannerKind.success ? Icons.circle-check : root.kind == BannerKind.warning ? Icons.triangle-exclamation : root.kind == BannerKind.error ? Icons.circle-exclamation : Icons.circle-info;
            size: 18px;
            tint: Tone.ink(root.tone);
        }
        Text { x: 48px; y: (root.stack ? 10px : 10px + (root.row-h - root.txt-h) / 2) + 4px; width: root.text-w; height: 20px; text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Text { x: 48px; y: (root.stack ? 10px : 10px + (root.row-h - root.txt-h) / 2) + 24px; width: root.text-w; height: root.bd-h; text: root.body; wrap: TextWrap.word-wrap; color: Theme.sub; font-size: 13px; }
        HorizontalLayout {
            x: root.stack ? 48px : root.width - 60px - root.act-w;
            y: root.stack ? 10px + root.txt-h + 4px : 10px + (root.row-h - 44px) / 2;
            height: 44px;
            width: root.act-w;
            spacing: 8px;
            alignment: start;
            if root.action-a != "": Btn { text: root.action-a; pad: 16px; min-w: 0px; clicked => { root.act(0); } }
            if root.action-b != "": Btn { text: root.action-b; pad: 16px; min-w: 0px; clicked => { root.act(1); } }
        }
        Btn {
            x: parent.width - 8px - 44px;
            y: root.stack ? 2px : (parent.height - 44px) / 2;
            kind: BtnKind.icon;
            icon: Icons.xmark;
            glyph: 13px;
            pad: 0px;
            clicked => { root.last = "Dismissed"; root.closed = true; }
        }
    }
}

// ---------------------------------------------------------------------------
// Notification center
// ---------------------------------------------------------------------------
component NotifCard inherits Rectangle {
    in property <IconDef> icon;
    in property <int> tone: 0;
    in property <string> app;
    in property <string> when;
    in property <string> title;
    in property <string> body;
    in property <string> action-a;
    in property <string> action-b;
    callback dismissed();
    property <length> bd-h: Math.max(1, Math.round(bd-m.preferred-height / 17.7px)) * 19px;
    property <bool> has-acts: root.action-a != "";
    // 8 px of outside margin is part of the height so a column of cards needs no spacing
    height: 12px + 22px + 6px + 20px + root.bd-h + (root.has-acts ? 40px : 0px) + 12px + 8px;

    bd-m := Text { visible: false; x: 0px; y: 0px; width: root.width - 28px; text: root.body; wrap: TextWrap.word-wrap; font-size: 13px; }
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 8px;
        border-radius: 14px;
        background: Theme.chip;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: root.title;
        Rectangle {
            x: 14px;
            y: 12px;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            background: Tone.tile(root.tone);
            Icon { icon: root.icon; size: 11px; tint: Tone.ink(root.tone); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        an := Text { x: 44px; y: 14px; height: 18px; text: root.app; color: Theme.sub; font-size: 12.5px; font-weight: 500; vertical-alignment: center; }
        Text { x: 44px + an.preferred-width + 8px; y: 14px; height: 18px; text: root.when; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
        Text { x: 14px; y: 40px; width: root.width - 14px - 50px; height: 20px; text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Text { x: 14px; y: 60px; width: root.width - 28px; height: root.bd-h; text: root.body; wrap: TextWrap.word-wrap; color: Theme.sub; font-size: 13px; }
        HorizontalLayout {
            x: 4px;
            y: 60px + root.bd-h + 4px;
            width: root.width - 8px;
            height: 44px;
            spacing: 2px;
            alignment: start;
            if root.action-a != "": Btn { kind: BtnKind.text; text: root.action-a; pad: 12px; min-w: 0px; clicked => { root.dismissed(); } }
            if root.action-b != "": Btn { kind: BtnKind.text; text: root.action-b; pad: 12px; min-w: 0px; clicked => { root.dismissed(); } }
        }
        Btn {
            x: root.width - 4px - 44px;
            y: 2px;
            kind: BtnKind.icon;
            icon: Icons.xmark;
            glyph: 13px;
            pad: 0px;
            clicked => { root.dismissed(); }
        }
    }
}

component GroupLabel inherits Rectangle {
    in property <string> text;
    height: 34px;
    Text { x: 6px; y: 12px; width: parent.width - 12px; height: 16px; text: root.text; color: Theme.muted; font-size: 11.5px; font-weight: 600; letter-spacing: 0.6px; vertical-alignment: center; }
}

export component NotifyCenter inherits Rectangle {
    in property <length> h: 860px;
    in-out property <bool> dnd: false;
    // which of the five sample cards are still on the list
    in-out property <[bool]> open: [true, true, true, true, true];
    in-out property <bool> closed: false;
    property <int> n-today: (root.open[0] ? 1 : 0) + (root.open[1] ? 1 : 0) + (root.open[2] ? 1 : 0);
    property <int> n-earlier: (root.open[3] ? 1 : 0) + (root.open[4] ? 1 : 0);
    property <bool> has-items: root.n-today + root.n-earlier > 0;
    property <color> chip2: Theme.dark ? rgba(255, 255, 255, 0.10) : rgba(50, 50, 56, 0.09);

    width: 400px;
    height: root.closed ? 132px : root.h;

    if root.closed: ClosedStub {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        radius: 20px;
        line1: "Panel closed with Esc";
        reopen => { root.closed = false; }
    }
    if !root.closed: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: "Notifications";
        Surface { x: 0px; y: 0px; width: parent.width; height: parent.height; elevation: Elevation.dialog; radius: 20px; }
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { fs.focus(); }
        }
        // header
        ht := Text { x: 20px; y: 22px; height: 28px; text: "Notifications"; color: Theme.text; font-size: 20px; font-weight: 600; vertical-alignment: center; }
        if root.dnd: Rectangle {
            x: 20px + ht.preferred-width + 10px;
            y: 24px;
            width: sl.preferred-width;
            height: 24px;
            border-radius: 12px;
            background: root.chip2;
            sl := HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                alignment: center;
                Icon { icon: Icons.bell-slash; size: 10px; tint: Theme.sub; y: (parent.height - self.height) / 2; }
                Text { text: "Silenced"; color: Theme.sub; font-size: 12px; font-weight: 600; vertical-alignment: center; }
            }
        }
        if root.has-items: Btn {
            x: parent.width - 10px - self.width;
            y: 14px;
            kind: BtnKind.text;
            text: "Clear all";
            pad: 12px;
            min-w: 0px;
            clicked => { root.open = [false, false, false, false, false]; }
        }
        // Do not disturb: the whole row is the switch
        Rectangle {
            x: 12px;
            y: 64px;
            width: parent.width - 24px;
            height: 60px;
            border-radius: 14px;
            background: dta.pressed ? (Theme.dark ? rgba(255, 255, 255, 0.14) : rgba(50, 50, 56, 0.12)) : dta.has-hover ? (Theme.dark ? rgba(255, 255, 255, 0.10) : rgba(50, 50, 56, 0.09)) : (Theme.dark ? rgba(255, 255, 255, 0.06) : rgba(50, 50, 56, 0.05));
            animate background { duration: Theme.dur-instant; easing: Theme.ease-std; }
            accessible-role: AccessibleRole.switch;
            accessible-checked: root.dnd;
            accessible-label: "Do not disturb";
            Rectangle {
                x: 14px;
                y: 12px;
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: root.dnd ? Theme.fade(Tone.ink(0), Theme.dark ? 0.20 : 0.14) : root.chip2;
                Icon { icon: Icons.bell-slash; size: 16px; tint: root.dnd ? Tone.ink(0) : Theme.sub; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            Text { x: 62px; y: 11px; width: parent.width - 62px - 70px; height: 20px; text: "Do not disturb"; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            Text { x: 62px; y: 31px; width: parent.width - 62px - 70px; height: 18px; text: root.dnd ? "On until 18:00. Alerts wait here quietly." : "Off. Alerts pop up in the corner."; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
            Rectangle {
                x: parent.width - 14px - 44px;
                y: 17px;
                width: 44px;
                height: 26px;
                border-radius: 13px;
                background: root.dnd ? (Theme.dark ? #3377E6 : #2468D6) : (Theme.dark ? #8E8E94 : #8A8A93);
                animate background { duration: Theme.dur-fast; easing: Theme.ease-std; }
                Rectangle {
                    x: root.dnd ? 21px : 3px;
                    y: 3px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: #FFFFFF;
                    drop-shadow-color: rgba(0, 0, 0, 0.3);
                    drop-shadow-blur: 3px;
                    drop-shadow-offset-y: 1px;
                    animate x { duration: Theme.dur-fast; easing: Theme.ease-std; }
                }
            }
            dta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.dnd = !root.dnd; fs.focus(); }
            }
            FocusRing { active: dfs.has-focus; corner: 14px; }
            dfs := FocusScope {
                focus-on-click: false;
                key-pressed(e) => {
                    if (e.text == " " || e.text == "\n") {
                        root.dnd = !root.dnd;
                        return accept;
                    }
                    return reject;
                }
            }
        }
        // the list
        if root.has-items: Flickable {
            x: 12px;
            y: 128px;
            width: parent.width - 24px;
            height: parent.height - 128px;
            VerticalLayout {
                width: parent.width;
                padding-top: 4px;
                padding-bottom: 16px;
                alignment: start;
                spacing: 0px;
                if root.n-today > 0: GroupLabel { text: "TODAY"; }
                if root.open[0]: NotifCard {
                    icon: Icons.gauge-high;
                    tone: 1;
                    app: "Widgets";
                    when: "now";
                    title: "Memory is high";
                    body: "91% in use. Web Browser uses 987 MB.";
                    action-a: "Open Task Manager";
                    action-b: "Snooze 1 h";
                    dismissed => { root.open[0] = false; }
                }
                if root.open[1]: NotifCard {
                    icon: Icons.hard-drive;
                    tone: 2;
                    app: "Disk Manager";
                    when: "12 min ago";
                    title: "Drive almost full";
                    body: "Home has 4.1 GB left. Emptying the trash frees 2.3 GB.";
                    action-a: "Open Disk Manager";
                    dismissed => { root.open[1] = false; }
                }
                if root.open[2]: NotifCard {
                    icon: Icons.rotate-right;
                    tone: 0;
                    app: "Updates";
                    when: "1 h ago";
                    title: "Update available";
                    body: Brand.product + " 0.9.3 is ready to install.";
                    action-a: "Install now";
                    action-b: "Later";
                    dismissed => { root.open[2] = false; }
                }
                if root.n-earlier > 0: GroupLabel { text: "EARLIER"; }
                if root.open[3]: NotifCard {
                    icon: Icons.note-sticky;
                    tone: 4;
                    app: "Notes";
                    when: "Yesterday";
                    title: "Note saved offline";
                    body: "“Shopping list” will sync when you are back online.";
                    dismissed => { root.open[3] = false; }
                }
                if root.open[4]: NotifCard {
                    icon: Icons.terminal;
                    tone: 3;
                    app: "Terminal";
                    when: "Yesterday";
                    title: "Command finished";
                    body: "make -j16 finished in 2 min 14 s.";
                    dismissed => { root.open[4] = false; }
                }
            }
        }
        // all caught up
        if !root.has-items: Rectangle {
            x: 0px;
            y: 128px;
            width: parent.width;
            height: parent.height - 128px - 56px;
            Rectangle {
                x: (parent.width - 64px) / 2;
                y: (parent.height - 187px) / 2;
                width: 64px;
                height: 64px;
                border-radius: 20px;
                background: Tone.tile(3);
                Icon { icon: Icons.check-double; size: 26px; tint: Tone.ink(3); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            Text { x: 0px; y: (parent.height - 187px) / 2 + 78px; width: parent.width; height: 24px; text: "You’re all caught up"; color: Theme.text; font-size: 16px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 0px; y: (parent.height - 187px) / 2 + 108px; width: parent.width; height: 19px; text: "New notifications will show up here, newest first."; color: Theme.sub; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            Btn {
                x: (parent.width - self.width) / 2;
                y: (parent.height - 187px) / 2 + 143px;
                text: "Bring them back";
                pad: 18px;
                clicked => { root.open = [true, true, true, true, true]; }
            }
        }
        fs := FocusScope {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.closed = true;
                    return accept;
                }
                return reject;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Quick settings
// ---------------------------------------------------------------------------
component QsTile inherits Rectangle {
    in property <IconDef> icon;
    in property <string> title;
    in property <string> state;
    in property <bool> on: false;
    callback toggled();
    property <bool> hov: ta.has-hover;
    height: 64px;
    border-radius: 14px;
    background: root.on ? (root.hov ? (Theme.dark ? #2862CC : #1D5BC4) : (Theme.dark ? #2F6FE6 : #2468D6))
        : root.hov ? (Theme.dark ? rgba(255, 255, 255, 0.12) : rgba(50, 50, 56, 0.11))
        : (Theme.dark ? rgba(255, 255, 255, 0.07) : rgba(50, 50, 56, 0.06));
    animate background { duration: Theme.dur-fast; easing: Theme.ease-std; }
    accessible-role: AccessibleRole.switch;
    accessible-checked: root.on;
    accessible-label: root.title + ", " + root.state;
    Rectangle {
        x: 12px;
        y: 14px;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: root.on ? Theme.fade(#FFFFFF, Theme.dark ? 0.20 : 0.22) : (Theme.dark ? rgba(255, 255, 255, 0.10) : rgba(50, 50, 56, 0.08));
        Icon { icon: root.icon; size: 16px; tint: root.on ? #FFFFFF : Theme.text; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
    Text { x: 58px; y: 13px; width: parent.width - 58px - 12px; height: 19px; text: root.title; color: root.on ? #FFFFFF : Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; }
    Text { x: 58px; y: 32px; width: parent.width - 58px - 12px; height: 18px; text: root.state; color: root.on ? #FFFFFF : Theme.muted; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
    FocusRing { active: fs.has-focus; corner: 14px; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

export component QuickSettings inherits Rectangle {
    // switches in tile order: Wi-Fi, Do not disturb, (Dark mode is the real theme), Airplane, Battery saver, Night light
    in-out property <[bool]> sw: [true, false, false, false, false, false];
    in-out property <float> bright: 0.72;
    in-out property <float> volume: 0.45;

    property <float> saved: 0.45;
    property <bool> muted: root.volume <= 0.004;

    width: 380px;
    height: 445px;

    Surface { x: 0px; y: 0px; width: parent.width; height: parent.height; elevation: Elevation.dialog; radius: 20px; }
    Text { x: 20px; y: 16px; width: 200px; height: 24px; text: "Quick settings"; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
    Text { x: parent.width - 20px - 160px; y: 19px; width: 160px; height: 18px; text: Brand.host; color: Theme.muted; font-size: 12.5px; horizontal-alignment: right; vertical-alignment: center; }
    QsTile {
        x: 16px;
        y: 52px;
        width: 170px;
        icon: Icons.wifi;
        title: "Wi-Fi";
        state: root.sw[0] && !root.sw[3] ? "Home-5G" : root.sw[3] ? "Off, airplane" : "Off";
        on: root.sw[0] && !root.sw[3];
        toggled => { root.sw[0] = !(root.sw[0] && !root.sw[3]); root.sw[3] = false; }
    }
    QsTile {
        x: 194px;
        y: 52px;
        width: 170px;
        icon: Icons.bell-slash;
        title: "Do not disturb";
        state: root.sw[1] ? "On" : "Off";
        on: root.sw[1];
        toggled => { root.sw[1] = !root.sw[1]; }
    }
    QsTile {
        x: 16px;
        y: 124px;
        width: 170px;
        icon: Icons.moon;
        title: "Dark mode";
        state: Theme.dark ? "On" : "Off";
        on: Theme.dark;
        toggled => { Theme.dark = !Theme.dark; }
    }
    QsTile {
        x: 194px;
        y: 124px;
        width: 170px;
        icon: Icons.plane;
        title: "Airplane mode";
        state: root.sw[3] ? "On" : "Off";
        on: root.sw[3];
        toggled => { root.sw[3] = !root.sw[3]; if (root.sw[3]) { root.sw[0] = false; } }
    }
    QsTile {
        x: 16px;
        y: 196px;
        width: 170px;
        icon: Icons.leaf;
        title: "Battery saver";
        state: root.sw[4] ? "On, until 20%" : "Off";
        on: root.sw[4];
        toggled => { root.sw[4] = !root.sw[4]; }
    }
    QsTile {
        x: 194px;
        y: 196px;
        width: 170px;
        icon: Icons.lightbulb;
        title: "Night light";
        state: root.sw[5] ? "Until sunrise" : "Off";
        on: root.sw[5];
        toggled => { root.sw[5] = !root.sw[5]; }
    }
    // sliders
    Icon { x: 16px + (44px - self.width) / 2; y: 270px + (44px - self.height) / 2; icon: Icons.sun; size: 17px; tint: Theme.sub; }
    Slide { x: 62px; y: 270px; width: 256px; value <=> root.bright; }
    Text { x: parent.width - 16px - 44px; y: 270px; width: 44px; height: 44px; text: "\{Math.round(root.bright * 100)}%"; color: Theme.sub; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
    Btn {
        x: 16px;
        y: 316px;
        kind: BtnKind.icon;
        icon: root.muted ? Icons.volume-xmark : Icons.volume-high;
        glyph: 17px;
        pad: 0px;
        clicked => {
            if (root.volume > 0.004) {
                root.saved = root.volume;
                root.volume = 0;
            } else {
                root.volume = root.saved > 0.004 ? root.saved : 0.45;
            }
        }
    }
    Slide { x: 62px; y: 316px; width: 256px; value <=> root.volume; }
    Text { x: parent.width - 16px - 44px; y: 316px; width: 44px; height: 44px; text: root.muted ? "Muted" : "\{Math.round(root.volume * 100)}%"; color: Theme.sub; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
    // battery and power
    Rectangle { x: 16px; y: 372px; width: parent.width - 32px; height: 1px; background: Theme.line; }
    Icon { x: 20px; y: 385px + (44px - self.height) / 2; icon: Icons.battery-half; size: 18px; tint: Theme.sub; }
    Text { x: 48px; y: 389px; width: 120px; height: 19px; text: "86%"; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
    Text { x: 48px; y: 408px; width: 160px; height: 17px; text: root.sw[4] ? "4 h 05 min left" : "3 h 20 min left"; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
    Btn { x: parent.width - 16px - 3 * 44px - 4px; y: 385px; kind: BtnKind.icon; icon: Icons.gear; glyph: 16px; pad: 0px; }
    Btn { x: parent.width - 16px - 2 * 44px - 2px; y: 385px; kind: BtnKind.icon; icon: Icons.lock; glyph: 16px; pad: 0px; }
    Btn { x: parent.width - 16px - 44px; y: 385px; kind: BtnKind.icon; icon: Icons.power-off; glyph: 16px; pad: 0px; }
}
