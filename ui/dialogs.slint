// Dialogs: one frame (icon, title, text, content, buttons) and the twelve stock dialogs built on it.
// The frame sizes itself from its content. Put anything between the text and the buttons
// as children of DialogCard.

import { Theme, Brand } from "theme.slint";
import { Icon, IconDef, Icons, Surface, Elevation, DashedBorder } from "base.slint";
import { Btn, BtnKind, CheckBox } from "controls.slint";

export struct DlgButton {
    text: string,
    kind: BtnKind,
    enabled: bool,
}

// ---------------------------------------------------------------------------
// Pieces
// ---------------------------------------------------------------------------

// Square 20 px mark used by the checkbox lists.
export component DlgBox inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border-width: 2px;
    border-color: root.checked ? Theme.ctl : Theme.field;
    background: root.checked ? Theme.ctl : transparent;
    animate background { duration: Theme.dur-instant; easing: Theme.ease-std; }
    if root.checked: Icon {
        icon: Icons.check;
        size: 11px;
        tint: Theme.on-primary;
        x: (parent.width - self.width) / 2 - 2px;
        y: (parent.height - self.height) / 2 - 2px;
    }
}

// Paragraph below the title, lined up with the title text.
export component DlgPara inherits Rectangle {
    in property <string> text;
    in property <length> indent: 78px;
    in property <length> top: 6px;
    in property <color> ink: Theme.sub;
    in property <length> px: 14px;
    height: root.top + t.preferred-height;
    t := Text {
        x: root.indent;
        y: root.top;
        width: root.width - root.indent - 24px;
        text: root.text;
        wrap: TextWrap.word-wrap;
        color: root.ink;
        font-size: root.px;
    }
}

// Gray box with a few lines of mono text (error details, logs).
export component DlgCode inherits Rectangle {
    in property <string> text;
    in property <length> indent: 78px;
    in property <length> gap: 14px;
    height: root.gap + 20px + t.preferred-height;
    Rectangle {
        x: root.indent;
        y: root.gap;
        width: root.width - root.indent - 24px;
        height: parent.height - root.gap;
        border-radius: 10px;
        background: Theme.chip;
        t := Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            text: root.text;
            wrap: TextWrap.word-wrap;
            color: Theme.sub;
            font-family: Theme.mono;
            font-size: 12px;
        }
    }
}

// Process line: icon, name, numbers.
export component DlgChip inherits Rectangle {
    in property <IconDef> icon;
    in property <string> name;
    in property <string> info;
    height: 14px + 44px;
    Rectangle {
        x: 78px;
        y: 14px;
        width: root.width - 78px - 24px;
        height: 44px;
        border-radius: 10px;
        background: Theme.chip;
        Rectangle {
            x: 12px;
            y: 10px;
            width: 24px;
            height: 24px;
            border-radius: 6px;
            background: Theme.chip;
            Icon { icon: root.icon; size: 12px; tint: Theme.muted; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        nm := Text { x: 46px; y: 0px; height: parent.height; text: root.name; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        Text { x: 46px + nm.preferred-width + 10px; y: 0px; width: parent.width - 60px - nm.preferred-width; height: parent.height; text: root.info; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
    }
}

// "Home    494 GB of 512 GB used" with a bar.
export component DlgUsage inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> fraction: 0.5;
    in property <color> ink: Theme.warn-line;
    height: 14px + 18px + 6px + 8px;
    Text { x: 78px; y: 14px; width: 150px; height: 18px; text: root.label; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
    Text { x: root.width - 24px - 220px; y: 14px; width: 220px; height: 18px; text: root.value; color: Theme.muted; font-size: 12.5px; horizontal-alignment: right; vertical-alignment: center; }
    Rectangle {
        x: 78px;
        y: 38px;
        width: root.width - 78px - 24px;
        height: 8px;
        border-radius: 4px;
        background: Theme.track;
        clip: true;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.fraction; height: parent.height; border-radius: 4px; background: root.ink; }
    }
}

// Check row under the text ("Don't ask again").
export component DlgCheck inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text;
    in property <length> indent: 66px;
    height: 8px + 44px;
    Rectangle {
        x: root.indent;
        y: 8px;
        width: root.width - root.indent - 24px;
        height: 44px;
        border-radius: 10px;
        background: cta.has-hover ? Theme.hover : transparent;
        DlgBox { x: 12px; y: 12px; checked: root.checked; }
        Text { x: 42px; y: 0px; width: parent.width - 54px; height: parent.height; text: root.text; color: Theme.text; font-size: 13.5px; vertical-alignment: center; }
        cta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.checked = !root.checked; }
        }
        accessible-role: AccessibleRole.checkbox;
        accessible-checked: root.checked;
        accessible-label: root.text;
    }
}

// ---------------------------------------------------------------------------
// The frame
// ---------------------------------------------------------------------------
export component DialogCard inherits Rectangle {
    in property <length> w: 420px;
    in property <IconDef> icon: Icons.circle-info;
    in property <int> tone: 0;                  // 0 accent, 1 warning, 2 danger, 3 ok
    in property <string> title;
    in property <string> sub;
    in property <string> body;
    in property <[DlgButton]> buttons;
    in property <length> tile: 40px;            // 40 normally, 44 for authentication
    in property <bool> closable: true;
    callback pick(int);
    callback close();

    property <color> raw: root.tone == 2 ? (Theme.dark ? #FF7A85 : #D6414F)
        : root.tone == 1 ? (Theme.dark ? #FFB85C : #F2A33A)
        : root.tone == 3 ? (Theme.dark ? #7FD35A : #3F8A1E)
        : (Theme.dark ? #6BA3FF : #2F6FD6);
    property <color> fg: root.tone == 2 ? Theme.danger-text : root.tone == 1 ? Theme.warn : root.tone == 3 ? Theme.ok : Theme.accent;
    property <length> text-x: 24px + root.tile + 14px;
    property <length> head-h: 20px + Math.max(44px, 2px + ttl.preferred-height + (root.sub != "" ? sb.preferred-height : 0px));

    width: root.w;
    height: lay.preferred-height;

    Surface {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        elevation: Elevation.dialog;
        radius: Theme.r-dialog;
    }
    lay := VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.w;
        alignment: start;
        // header
        Rectangle {
            height: root.head-h;
            Rectangle {
                x: 24px;
                y: 20px;
                width: root.tile;
                height: root.tile;
                border-radius: root.tile > 40px ? 14px : 12px;
                background: Theme.fade(root.raw, 0.16);
                Icon { icon: root.icon; size: root.tile > 40px ? 20px : 18px; tint: root.fg; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            ttl := Text {
                x: root.text-x;
                y: 22px;
                width: root.w - root.text-x - 66px;
                text: root.title;
                wrap: TextWrap.word-wrap;
                color: Theme.text;
                font-size: 17px;
                font-weight: 600;
            }
            sb := Text {
                x: root.text-x;
                y: 22px + ttl.preferred-height;
                width: root.w - root.text-x - 66px;
                text: root.sub;
                wrap: TextWrap.word-wrap;
                color: Theme.muted;
                font-size: 13px;
            }
            if root.closable: Rectangle {
                x: root.w - 52px;
                y: 20px;
                width: 44px;
                height: 44px;
                border-radius: 10px;
                background: cx.has-hover ? Theme.hover : transparent;
                accessible-role: AccessibleRole.button;
                accessible-label: "Close dialog";
                Icon { icon: Icons.xmark; size: 14px; tint: Theme.muted; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                cx := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.close(); }
                }
            }
        }
        // paragraph
        if root.body != "": DlgPara { text: root.body; indent: root.text-x; }
        // content from the caller
        @children
        // buttons
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 24px;
            spacing: 8px;
            alignment: end;
            for b[i] in root.buttons: Btn {
                text: b.text;
                kind: b.kind;
                enabled: b.enabled;
                min-w: 88px;
                clicked => { root.pick(i); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The twelve stock dialogs
// ---------------------------------------------------------------------------
export enum DialogKind { remove, reset, endtask, unsaved, error, permission, startup, diskfull, highload, noroom, quickactions, shortcuts }

struct StockDef {
    icon: IconDef,
    tone: int,
    title: string,
    sub: string,
    body: string,
    buttons: [DlgButton],
    wide: bool,
}

struct AppRow {
    icon: IconDef,
    name: string,
}

struct KeyRow {
    what: string,
    key: string,
}

export component StockDialog inherits Rectangle {
    in property <DialogKind> kind: DialogKind.remove;
    in-out property <bool> closed: false;
    callback chosen(int);                       // index of the pressed button

    in-out property <bool> check: false;
    in-out property <[bool]> picked: [true, true, true, false, false, false];
    property <int> n-picked: (root.picked[0] ? 1 : 0) + (root.picked[1] ? 1 : 0) + (root.picked[2] ? 1 : 0) + (root.picked[3] ? 1 : 0) + (root.picked[4] ? 1 : 0) + (root.picked[5] ? 1 : 0);
    property <[AppRow]> apps: [
        { icon: Icons.chart-line, name: "Task Manager" },
        { icon: Icons.terminal, name: "Terminal" },
        { icon: Icons.folder, name: "Files" },
        { icon: Icons.calculator, name: "Calculator" },
        { icon: Icons.note-sticky, name: "Notes" },
        { icon: Icons.gear, name: "Settings" },
    ];
    property <[KeyRow]> keys: [
        { what: "Edit layout", key: "E" },
        { what: "Move the selected widget", key: "Arrow keys" },
        { what: "Resize the selected widget", key: "Shift + Arrows" },
        { what: "Pause or resume updates", key: "Space" },
        { what: "Open in Task Manager", key: "Enter" },
        { what: "Remove the selected widget", key: "Delete" },
    ];
    pure function idx(k: DialogKind) -> int {
        k == DialogKind.remove ? 0 : k == DialogKind.reset ? 1 : k == DialogKind.endtask ? 2 : k == DialogKind.unsaved ? 3
            : k == DialogKind.error ? 4 : k == DialogKind.permission ? 5 : k == DialogKind.startup ? 6 : k == DialogKind.diskfull ? 7
            : k == DialogKind.highload ? 8 : k == DialogKind.noroom ? 9 : k == DialogKind.quickactions ? 10 : 11
    }
    property <[StockDef]> defs: [
        { icon: Icons.trash-can, tone: 2, title: "Remove CPU widget?", sub: "", wide: false,
          body: "It leaves your desktop. You can add it again from Add widgets, and its settings are kept for 30 days.",
          buttons: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Remove", kind: BtnKind.danger, enabled: true }] },
        { icon: Icons.rotate-right, tone: 0, title: "Reset widget layout?", sub: "", wide: false,
          body: "Every widget goes back to its default place and size. Your widget settings are not changed.",
          buttons: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Reset layout", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.triangle-exclamation, tone: 1, title: "End Web Browser?", sub: "", wide: false,
          body: "Unsaved work in this app will be lost.",
          buttons: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "End task", kind: BtnKind.danger, enabled: true }] },
        { icon: Icons.sliders, tone: 0, title: "Save changes to CPU widget?", sub: "", wide: false,
          body: "You changed the size and the warning level. Close without saving and they go back to what they were.",
          buttons: [{ text: "Don’t save", kind: BtnKind.ghost, enabled: true }, { text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Save", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.triangle-exclamation, tone: 2, title: "Can’t read CPU sensors", sub: "", wide: false,
          body: "The widget could not get a reading from the system. This often fixes itself in a moment.",
          buttons: [{ text: "Copy details", kind: BtnKind.secondary, enabled: true }, { text: "Close", kind: BtnKind.secondary, enabled: true }, { text: "Retry", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.hard-drive, tone: 0, title: "Let Disk read drive health?", sub: "", wide: false,
          body: "The Disk widget wants to show the temperature and wear level of your NVMe drive. It cannot read your files or change anything.",
          buttons: [{ text: "Not now", kind: BtnKind.secondary, enabled: true }, { text: "Allow", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.rocket, tone: 0, title: "Turn off Cloud Sync at startup?", sub: "", wide: false,
          body: "It will no longer start when you sign in, and syncing waits until you open it. Sign-in becomes about 2.1 seconds faster.",
          buttons: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Turn off", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.hard-drive, tone: 1, title: "Storage is almost full", sub: "", wide: false,
          body: "Home has 18 GB free. Apps may slow down or fail to save below 5 GB.",
          buttons: [{ text: "Later", kind: BtnKind.secondary, enabled: true }, { text: "Open Disk Manager", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.chart-line, tone: 1, title: "CPU has been high for 5 minutes", sub: "", wide: false,
          body: "Web Browser is using 78% of the processor. Everything else may feel slow.",
          buttons: [{ text: "Snooze for 1 hour", kind: BtnKind.secondary, enabled: true }, { text: "Open Task Manager", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.expand, tone: 1, title: "Not enough room to resize", sub: "", wide: false,
          body: "Large needs 336 × 336 and the space below is taken. Move the CPU widget to the first free spot to make it Large.",
          buttons: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Move and resize", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.bolt, tone: 0, title: "Choose quick actions", sub: "Pick up to 4 apps for the widget.", body: "", wide: true,
          buttons: [{ text: "Cancel", kind: BtnKind.secondary, enabled: true }, { text: "Done", kind: BtnKind.primary, enabled: true }] },
        { icon: Icons.terminal, tone: 0, title: "Keyboard shortcuts", sub: "For the widgets on your desktop.", body: "", wide: true,
          buttons: [{ text: "Close", kind: BtnKind.primary, enabled: true }] },
    ];
    property <int> i: root.idx(root.kind);
    property <StockDef> d: root.defs[root.i];

    width: root.d.wide ? 440px : 420px;
    height: root.closed ? 132px : card.height;

    if root.closed: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 132px;
        border-radius: 16px;
        background: Theme.panel;
        DashedBorder { x: 0px; y: 0px; width: parent.width; height: parent.height; radius: 16px; ink: Theme.rule; thickness: 2px; dash: 7px; gap: 5px; }
        Text { x: 0px; y: 28px; width: parent.width; height: 20px; text: "Dialog closed"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        Btn { x: (parent.width - self.width) / 2; y: 58px; text: "Show it again"; clicked => { root.closed = false; } }
    }
    card := DialogCard {
        x: 0px;
        y: 0px;
        visible: !root.closed;
        w: root.width;
        icon: root.d.icon;
        tone: root.d.tone;
        title: root.d.title;
        sub: root.d.sub;
        body: root.d.body;
        buttons: root.d.buttons;
        pick(n) => { root.chosen(n); root.closed = true; }
        close => { root.closed = true; }

        if root.kind == DialogKind.endtask: DlgChip { icon: Icons.globe; name: "Web Browser"; info: "11.4% CPU, 984 MB"; }
        if root.kind == DialogKind.endtask: DlgCheck { text: "Don't ask again for this app"; checked <=> root.check; }
        if root.kind == DialogKind.error: DlgCode { text: "sensors: permission denied\n/sys/class/hwmon/hwmon0/temp1_input"; }
        if root.kind == DialogKind.diskfull: DlgUsage { label: "Home"; value: "494 GB of 512 GB used"; fraction: 0.965; }
        if root.kind == DialogKind.quickactions: Rectangle {
            height: 12px + 6 * 48px + 24px;
            for a[k] in root.apps: Rectangle {
                x: 12px;
                y: 12px + k * 48px;
                width: root.width - 24px;
                height: 48px;
                border-radius: 10px;
                background: ra.has-hover && (root.picked[k] || root.n-picked < 4) ? Theme.hover : transparent;
                opacity: !root.picked[k] && root.n-picked >= 4 ? 0.5 : 1;
                accessible-role: AccessibleRole.checkbox;
                accessible-checked: root.picked[k];
                accessible-label: a.name;
                Rectangle {
                    x: 12px;
                    y: 10px;
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    background: Theme.chip;
                    Icon { icon: a.icon; size: 14px; tint: Theme.muted; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                Text { x: 52px; y: 0px; width: parent.width - 100px; height: parent.height; text: a.name; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                DlgBox { x: parent.width - 32px; y: 14px; checked: root.picked[k]; }
                ra := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        if (root.picked[k] || root.n-picked < 4) {
                            root.picked[k] = !root.picked[k];
                        }
                    }
                }
            }
            Text { x: 24px; y: 12px + 6 * 48px + 6px; width: 300px; height: 18px; text: "\{root.n-picked} of 4 selected"; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
        }
        if root.kind == DialogKind.shortcuts: Rectangle {
            height: 8px + 6 * 44px;
            for r[k] in root.keys: Rectangle {
                x: 24px;
                y: 8px + k * 44px;
                width: root.width - 48px;
                height: 44px;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
                Text { x: 0px; y: 0px; width: parent.width - 120px; height: parent.height; text: r.what; color: Theme.sub; font-size: 13.5px; vertical-alignment: center; }
                Rectangle {
                    x: parent.width - self.width;
                    y: 10px;
                    width: Math.max(26px, kt.preferred-width + 16px);
                    height: 24px;
                    border-radius: 6px;
                    background: Theme.chip;
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; border-radius: 0.5px; background: Theme.rule; }
                    kt := Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: r.key; color: Theme.text; font-family: Theme.mono; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
