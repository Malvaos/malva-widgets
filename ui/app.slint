// The gallery: a sidebar of pages, a light/dark switch, and a clock that makes the graphs move.
// Run it with:  slint-viewer ui/app.slint

import { Theme, Brand } from "theme.slint";
import { Icons, Icon, IconDef, Surface } from "base.slint";
import { Toggle } from "controls.slint";
import { Mock } from "mock.slint";
import { WidgetsPage } from "pages/widgets_page.slint";
import { ControlsPage } from "pages/controls_page.slint";
import { DialogsPage, MoreDialogsPage } from "pages/dialogs_page.slint";

struct NavItem {
    name: string,
    icon: IconDef,
}

export component App inherits Window {
    title: Brand.product;
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.page;
    default-font-family: Theme.font;
    in-out property <bool> dark <=> Theme.dark;
    in-out property <int> page: 0;

    property <[NavItem]> nav: [
        { name: "Widgets", icon: Icons.layer-group },
        { name: "Controls", icon: Icons.sliders },
        { name: "Dialogs", icon: Icons.comment },
        { name: "More dialogs", icon: Icons.list-check },
    ];

    // one frame per second for every live graph
    Timer {
        interval: 1s;
        running: true;
        triggered => { Mock.tick = Mock.tick + 1 >= Mock.frames ? 0 : Mock.tick + 1; }
    }

    // ---- content ------------------------------------------------------------
    Flickable {
        x: 232px;
        y: 0px;
        width: root.width - 232px;
        height: root.height;
        content-width: Math.max(self.width, 1264px);
        content-height: [wp.height, cp.height, dp.height, mp.height][root.page];
        wp := WidgetsPage { x: Math.max(0px, (parent.width - self.width) / 2); y: 0px; visible: root.page == 0; }
        cp := ControlsPage { x: Math.max(0px, (parent.width - self.width) / 2); y: 0px; visible: root.page == 1; }
        dp := DialogsPage { x: Math.max(0px, (parent.width - self.width) / 2); y: 0px; visible: root.page == 2; }
        mp := MoreDialogsPage { x: Math.max(0px, (parent.width - self.width) / 2); y: 0px; visible: root.page == 3; }
    }

    // ---- sidebar ------------------------------------------------------------------
    Rectangle {
        x: 0px;
        y: 0px;
        width: 232px;
        height: root.height;
        background: Theme.panel;
        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.line; }
        Rectangle {
            x: 20px;
            y: 24px;
            width: 192px;
            height: 44px;
            Rectangle {
                x: 0px;
                y: 4px;
                width: 36px;
                height: 36px;
                border-radius: 10px;
                Image { source: @image-url("assets/malva-mark.svg"); width: 32px; height: 32px; x: 2px; y: 2px; image-fit: contain; }
            }
            Text { x: 48px; y: 0px; width: 144px; height: 24px; text: Brand.product; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            Text { x: 48px; y: 22px; width: 144px; height: 18px; text: "UI kit, Slint " + Brand.version; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
        }
        for item[i] in root.nav: Rectangle {
            x: 12px;
            y: 92px + i * 48px;
            width: 208px;
            height: 44px;
            border-radius: 10px;
            background: root.page == i ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.dur-fast; easing: Theme.ease-std; }
            accessible-role: AccessibleRole.tab;
            accessible-label: item.name;
            Icon { x: 14px; y: (parent.height - self.height) / 2; icon: item.icon; size: 15px; tint: root.page == i ? Theme.accent-text : Theme.muted; }
            Text {
                x: 44px;
                y: 0px;
                width: 150px;
                height: parent.height;
                text: item.name;
                color: root.page == i ? Theme.accent-text : Theme.text;
                font-size: 14px;
                font-weight: root.page == i ? 600 : 400;
                vertical-alignment: center;
            }
            ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.page = i; }
            }
        }
        // light / dark
        Rectangle {
            x: 12px;
            y: root.height - 68px;
            width: 208px;
            height: 44px;
            Icon { x: 14px; y: (parent.height - self.height) / 2; icon: Theme.dark ? Icons.moon : Icons.sun; size: 15px; tint: Theme.muted; }
            Text { x: 44px; y: 0px; width: 100px; height: parent.height; text: Theme.dark ? "Dark" : "Light"; color: Theme.text; font-size: 14px; vertical-alignment: center; }
            Toggle { x: 152px; y: 9px; on <=> Theme.dark; }
        }
    }
}
